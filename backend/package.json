{
  "name": "tally-middleware-backend",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "main": "electron.cjs",
  "bin": "server.js",
  "dependencies": {
    "agentkeepalive": "^4.5.0",
    "axios": "^1.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "node-cron": "^4.2.1",
    "object-assign": "^4.1.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "app-builder-bin": "^5.0.0-alpha.12",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.28.0",
    "nodemon": "^3.0.0",
    "pkg": "^5.8.1"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/license_verification.test.mjs",
    "electron": "electron electron.cjs",
    "build:exe": "node build.mjs",
    "build:app": "node build.mjs && electron-builder --win --x64",
    "build:clean": "node -e \"require('fs').rmSync('electron-dist',{recursive:true,force:true});require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build:app"
  },
  "pkg": {
    "assets": [
      "node_modules/**/*",
      "config/**/*",
      "routes/**/*",
      "tally/**/*",
      "syncState.js",
      "syncChunkState.js",
      "agent/agent.cjs"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "build": {
    "appId": "com.tally.erpnext.integration",
    "productName": "TallyERP Integration",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "electron.cjs",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.png",
      "signExts": null,
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeaderIcon": "assets/icon.png"
    }
  }
}
